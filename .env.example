# ─── Database ────────────────────────────────────────────────
# Local/dev: SQLite (zero setup, just works)
# Production (multi-tenant): swap to PostgreSQL, e.g.
#   postgresql://USER:PASS@HOST:5432/beauty_salon
DATABASE_URL="file:./dev.db"

# ─── Auth ────────────────────────────────────────────────────
NEXTAUTH_SECRET="change-me-to-a-long-random-string"
NEXTAUTH_URL="http://localhost:9091"

# ─── Subdomain routing ───────────────────────────────────────
# Root domain for per-salon subdomains ({subdomain}.ROOT_DOMAIN).
# Use "localhost" for local dev; the /s/{slug} path always works as a fallback.
ROOT_DOMAIN="localhost"

# ─── ZarinPal (payment gateway) ──────────────────────────────
# Sandbox=true by default for dev/testing. Set to "false" + real merchant for production.
ZARINPAL_MERCHANT_ID="XXXXXXXX-XXXX-XXXX-XXXX-XXXXXXXXXXXX"
ZARINPAL_SANDBOX="true"

# ─── SMS (Kavenegar) ─────────────────────────────────────────
# Leave blank in dev: notifications fall back to in-panel + email only.
KAVENEGAR_API_KEY=""
KAVENEGAR_SENDER=""
SMS_COST_PER_MESSAGE="400"

# ─── Reminder cron (GET|POST /api/cron/reminders) ────────────
# Set CRON_SECRET in production and pass it via header x-cron-secret or ?secret=.
CRON_SECRET=""
REMINDER_WINDOW_HOURS="24"

# ─── Email (SMTP) ────────────────────────────────────────────
# Leave blank in dev: email sending is skipped silently.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""

# ─── Platform owner (seeded on first run) ────────────────────
PLATFORM_EMAIL="platform@salon.local"
PLATFORM_PASSWORD="Platform@123"
